# Documentation only: ChapterCast reads environment variables, not this file.
# All examples use loopback and ignored project-local storage.
CHAPTERCAST_HOST=127.0.0.1
CHAPTERCAST_PORT=8000
CHAPTERCAST_DATA_DIR=.runtime
CHAPTERCAST_INFERENCE_THREADS=4
# Additional exact request hostnames only; does not expose or activate a service.
# Set privately for the approved HTTPS hostname when issue #8 is authorised.
CHAPTERCAST_TRUSTED_HOSTS=
